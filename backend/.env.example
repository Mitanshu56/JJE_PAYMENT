MONGODB_URL=mongodb+srv://jje:<db_password>@jje.yusbbcm.mongodb.net/?appName=JJE
MONGODB_DB_NAME=
DEBUG=True
LOG_LEVEL=INFO
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET_KEY=change-this-secret-in-production
AUTH_TOKEN_EXPIRE_HOURS=87600
AUTH_RESET_TOKEN_EXPIRE_HOURS=24
FRONTEND_BASE_URL=http://localhost:3000
RECOVERY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# LLM provider configuration
# Set to 'deepseek', 'openrouter', 'groq', or 'openai'
LLM_PROVIDER=groq
# The model name to request from the provider
LLM_MODEL=llama-3.1-8b-instant
# Groq API key (OpenAI-compatible endpoint)
GROQ_API_KEY=
# Optional: custom Groq base
#GROQ_API_BASE=https://api.groq.com/openai/v1

# Optional keys for other providers
#OPENROUTER_API_KEY=
#DEEPSEEK_API_KEY=
#OPENAI_API_KEY=

# --- Guidance ---
# Do NOT commit your real secrets (passwords, API keys) to the repository.
# Steps to configure the MongoDB Atlas URI securely:
# 1) Locally: create a file `backend/.env` (this file is gitignored) with:
#
#    MONGODB_URL="mongodb+srv://jje:YOUR_PASSWORD@jje.yusbbcm.mongodb.net/payment_tracking?retryWrites=true&w=majority"
#    MONGODB_DB_NAME=payment_tracking
#
# 2) Fly.io (recommended for backend):
#    - Install `flyctl` and login.
#    - Set the secret: `flyctl secrets set MONGODB_URL="mongodb+srv://jje:YOUR_PASSWORD@jje.yusbbcm.mongodb.net/payment_tracking?retryWrites=true&w=majority"`
#    - Your app will read `MONGODB_URL` from the environment at runtime.
#
# 3) Vercel (if you host backend or serverless functions there):
#    - In Project Settings → Environment Variables, add `MONGODB_URL` and set the value.
#    - Use `VERCEL_ENV` scoping (Production, Preview, Development) as appropriate.
#
# 4) If your password contains special characters, URL-encode them (percent-encoding).
#
# 5) Verify connection locally before deploying:
#    - Activate backend virtualenv and run: `uvicorn app.main:app --reload --port 8000`
#    - The app will read `backend/.env` automatically via settings.

